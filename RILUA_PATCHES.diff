+// ---------------------------------------------------------------------------
+// "C" locale fast path
+// ---------------------------------------------------------------------------
+//
+// Character classification, case conversion, string collation and the
+// decimal point all have fixed, ASCII-only answers in the "C" locale (the
+// default for every C program). Calling the C runtime for each character is
+// slow (especially msvcrt.dll on Windows), so when the locale is "C" the
+// callers use pure-Rust equivalents with identical results. The cache is
+// refreshed when a state is created and whenever `os.setlocale` runs.
+
+static LOCALE_IS_C: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(true);
+
+/// True when the current C locale is "C"/"POSIX" (ASCII semantics).
+#[inline]
+pub(crate) fn locale_is_c() -> bool {
+    LOCALE_IS_C.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+/// Re-reads the current C locale into the cache.
+#[allow(unsafe_code)]
+pub(crate) fn refresh_locale_cache() {
+    #[cfg(target_arch = "wasm32")]
+    let is_c = true;
+    #[cfg(not(target_arch = "wasm32"))]
+    let is_c = unsafe {
+        let p = setlocale(locale::LC_ALL, std::ptr::null());
+        if p.is_null() {
+            true
+        } else {
+            let name = std::ffi::CStr::from_ptr(p.cast()).to_bytes();
+            name == b"C" || name == b"POSIX"
+        }
+    };
+    LOCALE_IS_C.store(is_c, std::sync::atomic::Ordering::Relaxed);
+}
