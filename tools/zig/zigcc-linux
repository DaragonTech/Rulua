#!/bin/sh
# `zig cc` for Linux against glibc 2.28, so the result runs on older
# distributions than the build machine (Ubuntu 18.10+, Debian 10+, RHEL 8+).
# ZIG_ARCH: x86_64 (default) or aarch64.
ZIG=${ZIG:-zig}
args=""
for a in "$@"; do
  case "$a" in
    --target=*|-m64) ;;
    *) args="$args '$(printf %s "$a" | sed "s/'/'\\\\''/g")'" ;;
  esac
done
eval exec "$ZIG" cc -target ${ZIG_ARCH:-x86_64}-linux-gnu.2.28 $args
